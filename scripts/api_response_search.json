<div class="vid-wrap">
    <video id="video-5c3d1854175b46aa9c31133614252d7e"
           preload="none"
           poster="https://assets.prawo-jazdy-360.pl/wyjasnienia-do-pytan-egzaminacyjnych/2094/2094.jpg"
           playsinline="true"
           controls>
    </video> 
    <div class="play-container fx fx-center" id="play-5c3d1854175b46aa9c31133614252d7e">
        <button class="fx fx-center">
            <div class="triangle"></div>
