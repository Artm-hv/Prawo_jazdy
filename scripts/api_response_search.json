    <script>
        $("#btn-next, #btn-next-xs").on("click", function () {
            fetchQuestion(null, false);
        });

        $("#question-answers input").on("change", function () {
            answerQuestion(this);
        });

        $("#btn-show-stats").on("click", function () {
            fetchStats();
        });
    </script>
