        <textarea class="f-control" placeholder="Wiadomość" rows="10" data-val="true" data-val-required="Pole wymagane" id="Message" name="Message">
</textarea>
        <span class="invalid field-validation-valid" data-valmsg-for="Message" data-valmsg-replace="true"></span>
    </div>
    


    <input type="hidden" data-val="true" data-val-required="The QuestionId field is required." id="QuestionId" name="QuestionId" value="2094" />
    <div class="f-group right">
        <button type="button" class="btn md" id="btn-explanation">Wyślij wiadomość</button>
    </div>
    <div id="explanation-response" style="display:none">
    </div>
