</div>

 <script>
     (function () {
        "use strict";

        const video = document.getElementById("video-5c3d1854175b46aa9c31133614252d7e");
        const playBtn = document.getElementById("play-5c3d1854175b46aa9c31133614252d7e");
        const questionId = '2094';
        const langStr = 'pl';
        const basePath = 'https://assets.prawo-jazdy-360.pl/wyjasnienia-do-pytan-egzaminacyjnych';

        const subtitles = [
            { label: "Polski", srclang: "pl" },
            { label: "English", srclang: "en" },
            { label: "Українська", srclang: "uk" },
            { label: "Deutsch", srclang: "de" },
            { label: "Русский", srclang: "ru" }
        ];

        function injectSubtitles() {
            subtitles.forEach(sub => {
                const track = document.createElement('track');
                track.kind = "subtitles";
                track.label = sub.label;
                track.srclang = sub.srclang;
                track.src = `${basePath}/${questionId}/${questionId}_${sub.srclang}.vtt`;

                if (sub.srclang === langStr) {
                    track.default = true;
                }

                video.appendChild(track);
            });
        }

        function enableSubtitles() {
            setTimeout(() => {
                for (let i = 0; i < video.textTracks.length; i++) {
                    const track = video.textTracks[i];
                    track.mode = (track.language === langStr) ? 'showing' : 'hidden';
                }
            }, 100);
        }

        function startVideo() {
            $(playBtn).hide();
            video.setAttribute('crossorigin', 'anonymous');
            injectSubtitles();

            const videoSrc = `${basePath}/${questionId}/hls/master.m3u8`;
            const videoSrcMp4 = `${basePath}/${questionId}/mp4/std/${questionId}.mp4`;

            if (window.Hls) {
                initHls(videoSrc, videoSrcMp4);
            } else {
                const script = document.createElement('script');
                script.src = "https://cdn.jsdelivr.net/npm/hls.js@1/dist/hls.light.min.js";
                script.onload = () => initHls(videoSrc, videoSrcMp4);
                document.head.appendChild(script);
            }
        }

        function initHls(src, fallback) {
            if (Hls.isSupported()) {
                const hls = new Hls();
                hls.loadSource(src);
                hls.attachMedia(video);
                hls.on(Hls.Events.MANIFEST_PARSED, () => {
                    video.play();
                    enableSubtitles();
                });
                hls.on(Hls.Events.ERROR, (event, data) => {
                    if (data.fatal) useMp4Fallback(fallback);
                });
            } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
                video.src = src;
                video.play();
                video.addEventListener("loadedmetadata", enableSubtitles);
            } else {
                useMp4Fallback(fallback);
            }
        }

        function useMp4Fallback(src) {
            video.src = src;
            video.load();
            video.play();
            video.addEventListener("loadedmetadata", enableSubtitles);
        }

        $(playBtn).on("click", startVideo);
    })();
</script>
