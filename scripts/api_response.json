<script>
    showAskModal = function (initialMessage) {
        const fillMessage = function () {
            if (!initialMessage) return;
            try {
                const askForm = document.getElementById('form-ask');
                const askMessageField = askForm?.querySelector('textarea[name="Message"]');

                if (askMessageField && !askMessageField.value) {
                    askMessageField.value = initialMessage;
                }
            } catch { }
        };

        loader.show();
        $.ajax({
            url: '/question/load-ask',
            request: 'json',
            response: 'text',
            data: 2091,
            success: function (response) {
                $("#partial-ask").html(`<div id="modal-ask" class="modal"><div class="dialog g-16"><i class="modal-close icon-x"></i>${response}</div></div>`);
                $("#modal-ask").modal("show");
                fillMessage();
            },
            complete: function () {
                loader.hide();
            }
        });
    }
</script>


