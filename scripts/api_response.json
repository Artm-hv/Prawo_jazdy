<script>
    if (typeof validator !== 'undefined')
        validator.scan(document.getElementById('form-explanation'));

    $("#btn-explanation").on("click", function (e) {
        $("#explanation-response").hide();
        let form = document.getElementById('form-explanation');

        if (validator.isValid(form)) {
            if(document.getElementById('is-satisfied-true').checked){
                loader.show();

                $.ajax({
                    url: '/question/explanation',
                    response: 'text',
                    data: new FormData(form),
                    success: function () {
                        form.reset();
                        $("#explanation-response").html("<span class='f-l'>Dziękujemy za wiadomość! Nasz zespół przeanalizuje Twoją wiadomość i wkrótce się z Tobą skontaktuje.</span>").show();
                    },
                    error: function () {
                        $("#explanation-response").html("<span class='field-validation-error invalid'>Coś poszło nie tak. Spróbuj ponownie.</span>").show();
                    },
                    complete: function () {
                        loader.hide();
                    }
                });
            }
            else{
                showAskModal(form.querySelector('textarea[name="Message"]').value);
            }
        }
    });
